<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      Lets the Bluetooth button open «Remotes & Accessories» and lets the launcher turn on its screensaver.
      Granted once from a computer: adb shell pm grant no.repsac.launcher android.permission.WRITE_SECURE_SETTINGS
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Lets «Start after» in the screensaver settings change how long the TV waits.
      Granted once from a computer: adb shell appops set no.repsac.launcher WRITE_SETTINGS allow
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- For «now playing» from Spotify -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the launcher see which other apps are installed -->
    <queries>
        <!-- The TV settings, so the Bluetooth button can open «Remotes & Accessories» -->
        <package android:name="com.android.tv.settings" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">

            <!-- Lets it be the home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Also shows it in the app list, so you can try it before making it the home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The screensaver (an Android «Dream») -->
        <service
            android:name=".Screensaver"
            android:exported="true"
            android:label="@string/screensaver_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!--
          Receives the Spotify login from tools/spotify-login.py. Only adb holds the DUMP permission,
          so no other app on the TV can send it.
        -->
        <receiver
            android:name=".SpotifyLoginReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="no.repsac.launcher.SPOTIFY_LOGIN" />
            </intent-filter>
        </receiver>

        <!-- Screensaver preview from the settings -->
        <activity
            android:name=".ScreensaverPreview"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
    </application>
</manifest>
